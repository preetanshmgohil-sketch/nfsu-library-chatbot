# NFSU Library Chatbot — backend environment
# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
DEBUG=true

# --- CORS (KOHA OPAC + local dev) ---
ALLOWED_ORIGINS=["https://catalog.nfsu.ac.in","http://localhost","http://127.0.0.1"]

# --- KOHA (live NFSU OPAC verified) ---
# Real paths: /cgi-bin/koha/opac-search.pl  ·  /cgi-bin/koha/opac-detail.pl
# Real indexes: '' (keyword) | ti | au | su | nb | ns | se | callnum
KOHA_OPAC_BASE_URL=https://catalog.nfsu.ac.in
# Scrape public OPAC results for real bibliographic cards (no credentials needed)
KOHA_SCRAPING_ENABLED=true
# If the hostname does not resolve on your network, pin the IP
# (Host header stays catalog.nfsu.ac.in). Example observed: 117.239.182.15
KOHA_PIN_IP=
# Optional structured REST mode (KOHA 22.05+)
KOHA_REST_BASE_URL=
KOHA_REST_TOKEN=

# --- LLM (Hugging Face Inference Providers — OpenAI-compatible) ---
# Option A (recommended): HF router — just paste a read token, no endpoint needed
LLM_API_TOKEN=
LLM_ENDPOINT_URL=
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=30
# Other good models for this task:
#   Qwen/Qwen2.5-3B-Instruct          (fast)
#   meta-llama/Llama-3.1-8B-Instruct  (alternative)
# Local Ollama alternative:
#   LLM_ENDPOINT_URL=http://localhost:11434
#   LLM_MODEL_NAME=llama3.1:8b

# --- Security ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_USER_MESSAGE_CHARS=2000
BLOCK_PROMPT_INJECTION=true

# --- Widget ---
WIDGET_ENABLED=true
WIDGET_SUSPENDED=false
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","hi"]
